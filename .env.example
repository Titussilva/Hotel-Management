# ──────────────────────────────────────────────────────────────────────────────
#  .env.example — Safe template committed to Git
#  Copy to .env and fill in real values. NEVER commit .env itself.
#
#  Hotel Booking System — d:\mern-2\Hotel-Management\
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: Atlas Dashboard → Connect → Drivers → Node.js
# Replace <user>, <password>, and <cluster> with your actual values.
# If your password contains @, /, or : → URL-encode them (@→%40, /→%2F, :→%3A)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel_booking_system?retryWrites=true&w=majority&appName=<cluster-name>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret (run in terminal):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-with-crypto-randomBytes-48-minimum-32-chars>

# ── Gmail (Nodemailer) ────────────────────────────────────────────────────────
# Use a Google App Password — NOT your account password.
# Enable at: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your deployed frontend URL — no trailing slash
# Local dev: http://localhost:5173
# Production: https://your-site.netlify.app
FRONTEND_URL=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Local dev: http://127.0.0.1:5000/api
# Production: set this in .env.production or Netlify env vars instead
VITE_API_URL=http://127.0.0.1:5000/api
