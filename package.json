    "express": "^4.21.2",
    "framer-motion": "^12.4.7",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongodb": "^7.2.0",
    "mongoose": "^8.10.0",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.10",
    "nodemon": "^3.1.9",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
